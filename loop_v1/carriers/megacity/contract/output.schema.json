{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "megacity carrier output json (megacity_out.json)",
  "description": "只记事实, 不记时序统计。帧时、离散度、归因全部由 loop_v1 从 raw ftrace 算, 载体侧不许有任何测量或判定逻辑 —— 与 refbench 同一条边界。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "carrier",
    "app_version",
    "run_id",
    "scene",
    "params",
    "route",
    "graphics",
    "frames_rendered",
    "clean_exit"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "carrier": { "const": "megacity" },
    "app_version": {
      "type": "string",
      "description": "Application.version, 上游 bundleVersion (当前 1.5.0)"
    },
    "harness_version": {
      "type": "string",
      "description": "本仓库这套胶水的版本, 与上游版本分开记"
    },
    "upstream_commit": {
      "type": "string",
      "description": "构建时 megacity-metro 的 git commit, 由构建脚本注入"
    },
    "run_id": { "type": "string" },
    "scene": { "enum": ["city_flythrough", "city_static"] },

    "params": {
      "type": "object",
      "required": ["frames", "warmup", "resscale", "vsync"],
      "properties": {
        "frames":   { "type": "integer" },
        "warmup":   { "type": "integer" },
        "resscale": { "type": "number" },
        "vsync":    { "enum": ["on", "off"] }
      }
    },

    "route": {
      "type": "object",
      "description": "相机路线的身份。两臂 sha256 不一致 = 走的不是同一条路线 = 这次对照无效。",
      "required": ["name", "sha256", "waypoints"],
      "properties": {
        "name":      { "type": "string" },
        "sha256":    { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "waypoints": { "type": "integer", "minimum": 2 }
      }
    },

    "graphics": {
      "type": "object",
      "required": ["api", "device_name", "width", "height", "vsync_count", "target_frame_rate"],
      "properties": {
        "api": {
          "type": "string",
          "description": "SystemInfo.graphicsDeviceType。必须是 Vulkan —— 落成 OpenGLES3 说明构建设置没生效, 该轮作废。"
        },
        "device_name":       { "type": "string" },
        "device_version":    { "type": "string" },
        "width":             { "type": "integer" },
        "height":            { "type": "integer" },
        "render_scale":      { "type": "number" },
        "vsync_count":       { "type": "integer" },
        "target_frame_rate": { "type": "integer" },
        "quality_level":     { "type": "string" },
        "srp_asset":         { "type": "string" }
      }
    },

    "render_thread_comm": {
      "type": "string",
      "description": "实测到的图形提交线程 comm 名 (harness 扫 /proc/self/task/*/comm 得到)。给 parse_trace.py --comm 用, 不靠猜。"
    },

    "frames_rendered": {
      "type": "integer",
      "description": "被测窗口内实际渲染帧数。< params.frames 说明中途被打断。"
    },
    "warmup_frames_rendered": { "type": "integer" },

    "clean_exit": {
      "type": "boolean",
      "description": "true = 预热完成、被测窗口跑满 frames 帧、路线全程有效。false = 任一环节失败, 该轮无效 (证据仍保留)。"
    },
    "abort_reason": {
      "type": "string",
      "description": "clean_exit=false 时必须给出原因: route_missing / route_invalid / streaming_timeout / focus_lost / exception"
    }
  }
}
